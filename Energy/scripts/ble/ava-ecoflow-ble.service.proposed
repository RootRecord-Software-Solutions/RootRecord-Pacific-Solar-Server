# PROPOSED — NOT INSTALLED. Staged 2026-09-29 (HST). Requires operator approval.
# Replaces: ~/.config/systemd/user/ava-ecoflow-ble.service (currently runs G2 .ollama/skills/energy/scripts/ble/ble-owner.py)
# Change: ExecStart → Pacific Energy/scripts/ble/ble-owner.py. Everything else unchanged.
# The Pacific copy writes its log to /home/rootrecord/Database/Logs/Energy/ava-ecoflow-ble.log and its pid to
# /home/rootrecord/Database/ENERGY/state/ava-ecoflow-ble.pid (was .ollama/skills/logs/store/… and .ollama/skills/state/store/…).
# Because the pid file moves, stop the legacy owner BEFORE starting this one (single BLE owner).
# Same cutover, Pacific Energy/config/devices.conf (not edited yet):
#   line 24  ble_log=/home/rootrecord/.ollama/skills/logs/store/ava-ecoflow-ble.log      → ble_log=/home/rootrecord/Database/Logs/Energy/ava-ecoflow-ble.log
#   line 98  owner_script=/home/rootrecord/.ollama/skills/energy/scripts/ble/ble-owner.py → owner_script=/home/rootrecord/RootRecord-Ecosystem/1 - Servers/1 - RootRecord-Pacific-Solar-Server/Energy/scripts/ble/ble-owner.py
# Apply (operator): systemctl --user stop ava-ecoflow-ble.service ; cp this file to ~/.config/systemd/user/ava-ecoflow-ble.service ;
#   edit devices.conf as above ; systemctl --user daemon-reload ; systemctl --user start ava-ecoflow-ble.service
[Unit]
Description=RootRecord EcoFlow BLE Owner
After=bluetooth.service
Wants=bluetooth.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 "/home/rootrecord/RootRecord-Ecosystem/1 - Servers/1 - RootRecord-Pacific-Solar-Server/Energy/scripts/ble/ble-owner.py"
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=default.target
