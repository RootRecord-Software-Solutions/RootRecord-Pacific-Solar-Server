# 12. NDFD GRIDPOINT — fetch/ndfd_gridpoint.py
# ---------------------------------------------------------------------------
ndfd:
  items:
  - id: points_resolver
    name: "NWS gridpoint resolver"
    tier: 6
    method: json
    url_template: "https://api.weather.gov/points/{lat},{lon}"
    note: "Resolves a coordinate to its NDFD gridpoint forecast URL. Cache the result — do not re-resolve every poll (per plan's open item)."
    # Coordinate list confirmed by user (session after nextagent.md's
    # handoff): reuse the same four ICAO stations already polled elsewhere
    # in this file (see e.g. clm_monthly_climate_summary's `stations` list
    # above), rather than a Hawaii-wide grid. Airport reference-point
    # coordinates, standard published values.
    points:
