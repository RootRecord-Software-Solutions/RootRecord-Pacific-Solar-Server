# PROPOSED — NOT INSTALLED. Staged 2026-09-29 (HST). Requires operator approval.
# Replaces: ~/.config/systemd/user/network-globe-hawaii.service (currently runs G2 .ollama/skills/coms/ssh/local-data-globe/collector.js)
# Change: WorkingDirectory + ExecStart → Pacific Communications/network/local-data-globe/. Everything else unchanged.
# Apply (operator): cp this file to ~/.config/systemd/user/network-globe-hawaii.service ; systemctl --user daemon-reload ; systemctl --user restart network-globe-hawaii.service
[Unit]
Description=RootRecord Hawaii Network Globe Collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/rootrecord/RootRecord-Ecosystem/1 - Servers/1 - RootRecord-Pacific-Solar-Server/Communications/network/local-data-globe
ExecStart=/usr/bin/node "/home/rootrecord/RootRecord-Ecosystem/1 - Servers/1 - RootRecord-Pacific-Solar-Server/Communications/network/local-data-globe/collector.js"
KillMode=control-group
TimeoutStopSec=15
