[Unit]
Description=Hold one EcoFlow pack GATT session open and refresh BLE samples
After=bluetooth.service
Wants=bluetooth.service

[Service]
Type=simple
ExecStart=/home/rootrecord/RootRecord-Ecosystem/1 - Servers/1 - RootRecord-Pacific-Solar-Server/Energy/.venv/bin/python "/home/rootrecord/RootRecord-Ecosystem/1 - Servers/1 - RootRecord-Pacific-Solar-Server/Energy/scripts/ble/ble-hold.py" --device river2pro
WorkingDirectory=/home/rootrecord/RootRecord-Ecosystem/1 - Servers/1 - RootRecord-Pacific-Solar-Server/Energy
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=20
Nice=5

[Install]
WantedBy=default.target
