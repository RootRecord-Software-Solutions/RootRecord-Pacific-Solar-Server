[Unit]
Description=RootRecord Telegram datapack pickup → Database (Mainland sysmon free buffer)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/rootrecord/datapack.env
EnvironmentFile=-/home/rootrecord/.env
WorkingDirectory=/home/rootrecord/RootRecord-Ecosystem/1 - Servers/1 - RootRecord-Pacific-Solar-Server/Communications/telegram
ExecStart=/home/rootrecord/RootRecord-Ecosystem/1 - Servers/1 - RootRecord-Pacific-Solar-Server/Communications/telegram/scripts/run-datapack-pickup.sh
User=rootrecord
