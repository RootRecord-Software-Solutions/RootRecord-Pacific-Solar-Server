{
  "name": "rootrecord-dev-desk",
  "version": "0.1.3",
  "private": true,
  "description": "Dev-Desk — RootRecord operator Electron desk",
  "main": "main.mjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --linux AppImage dir --x64",
    "dist": "electron-builder --linux AppImage deb --x64",
    "pack:win": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "cloud.rootrecord.devdesk",
    "productName": "Dev-Desk",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.mjs",
      "preload.cjs",
      "renderer/**/*",
      "lib/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "dir"
      ],
      "category": "Network",
      "artifactName": "AvaIvy-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "dir"
      ],
      "signAndEditExecutable": false,
      "artifactName": "AvaIvy-${version}-portable.exe"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
