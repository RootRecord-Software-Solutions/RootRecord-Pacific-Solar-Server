# ==============================================================================
# RootRecord-Cloud (Vercel, Next.js 15) — environment variable NAMES ONLY
# ------------------------------------------------------------------------------
# Names only. Desk folder 3 - RootRecord-Website/ was removed 2026-09-30. Values stay in Vercel.
# Real values live ONLY in the Vercel project settings (or a gitignored .env.local in the clone
# for local builds). All six are optional: the code has built-in defaults (shown as comments).
# None is a secret today (URLs only). NEVER put a value on a line below.
# ==============================================================================

# Server-side desk origin for /api/[...path] proxy, /api/chat and desk-api.ts (default https://origin.avaivy.cloud)
AVA_ORIGIN_URL=
# Server-side override of the public desk API base (desk-api.ts; fallback after NEXT_PUBLIC_AVA_API)
AVA_PUBLIC_API=
# Browser desk API base — leave UNSET so the browser uses same-origin /api/* (inlined at build time)
NEXT_PUBLIC_AVA_API=
# Goals API (goals-api.ts; default https://api-goals.rootrecord.info) — inlined at build time
NEXT_PUBLIC_GOALS_API=
# Account/auth API (AuthBar.tsx, /api/auth/session; default https://api.rootrecord.info) — inlined at build time
NEXT_PUBLIC_ACCOUNT_API=
# Server-side account API for /api/auth/session (preferred over NEXT_PUBLIC_ACCOUNT_API)
ROOTRECORD_API_ACCOUNT_URL=

# Build-time only (local smoke): NEXT_TELEMETRY_DISABLED=1
NEXT_TELEMETRY_DISABLED=
